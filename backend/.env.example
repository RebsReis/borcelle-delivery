# Banco de dados
DATABASE_URL=postgresql+psycopg://borcelle:borcelle@localhost:5432/borcelle

# URLs públicas
FRONTEND_URL=http://localhost:3000
# Precisa ser HTTPS público para o Mercado Pago enviar webhooks (use ngrok/cloudflared em dev)
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Rota administrativa provisória (fase 1). Gere com: openssl rand -hex 32
ADMIN_API_KEY=

# Mercado Pago — credenciais TEST-... = sandbox; APP_USR-... = produção
# Painel: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# "Assinatura secreta" do painel em Webhooks > Configurar notificações
MP_WEBHOOK_SECRET=
PIX_EXPIRATION_MINUTES=30

# Conferência periódica de pagamentos pendentes (segundos; 0 desliga)
RECONCILE_INTERVAL_SECONDS=60

# Meta Conversions API (opcional)
META_PIXEL_ID=
META_CAPI_TOKEN=

# WhatsApp Cloud API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
